# Salin menjadi .env lalu sesuaikan
APP_ENV=dev

# Koneksi ke DB (isi sesuai DB yang disiapkan teman setim)
# SQLite lokal untuk dev:
DATABASE_URL=sqlite:///./hackx.db
# PostgreSQL contoh:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname

# false = perintah hanya dicatat (dry-run), true = benar-benar kirim ke saklar
CONTROL_LIVE_MODE=false

# Faktor emisi listrik (kgCO2/kWh). Default 0.87 = sistem Jamali (JCM, merujuk ESDM 2019).
# Ganti sesuai sumber yang akan kamu sitasi.
EMISSION_FACTOR_KG_PER_KWH=0.87

# MQTT (broker di laptop; lihat docs/mqtt-contract.md dan deploy/mosquitto/)
MQTT_ENABLED=false
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=engine
# Sandi akun engine ada di deploy/mosquitto/credentials.txt (jangan di-commit)
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=smartx
# Prioritas fisik setelah tombol dosen (detik)
LOCAL_LOCK_SECONDS=120
# Jeda person_count=0 beruntun sebelum rule mematikan perangkat (detik).
# Default demo 20; untuk produksi pertimbangkan nilai lebih panjang, mis. 300.
EMPTY_DELAY_SECONDS=20
# Kamera dianggap UNKNOWN dan timer kosong direset setelah tidak ada pesan selama ini.
VISION_STALE_SECONDS=6
# Ambang orang minimum dan durasi konfirmasi okupansi sebelum auto ON.
ON_MIN_PERSONS=1
ON_DELAY_SECONDS=2
# URL fallback CCTV global; bisa berupa URL HLS .m3u8 atau halaman pemutar MediaMTX
PREVIEW_URL=

# Token halaman admin (header X-Admin-Token). Kosong = /admin ditolak. Isi string acak panjang, jangan di-commit.
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
